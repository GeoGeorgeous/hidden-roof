{
  "name": "roof-hidden-haus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mp": "tsc --noEmit && vite build --mode multiplayer --outDir dist-mp",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "golden": "node scripts/golden-paint.mjs",
    "bench:save": "node scripts/save-size.bench.mjs",
    "test": "node scripts/paint-file.test.mjs",
    "test:game": "node scripts/game.test.mjs",
    "check": "npm run typecheck && npm test && npm run smoke && npm run test:game && knip",
    "audit": "knip; jscpd src"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
